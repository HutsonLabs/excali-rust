{
  "name": "excali-rust-goldens",
  "private": true,
  "type": "module",
  "description": "Golden generator: runs upstream Excalidraw's own shape builders from the pinned checkout under Node, with the exact rough.js and perfect-freehand versions upstream pins.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "check": "node generate.mjs --check",
    "test": "node --test test/"
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "es6-promise-pool": "2.5.0",
    "esbuild": "0.28.2",
    "jsdom": "22.1.0",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "pako": "2.0.3",
    "perfect-freehand": "1.2.0",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "roughjs": "4.6.4",
    "tinycolor2": "1.6.0"
  }
}
